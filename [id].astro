---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { Content } = await render(post);

const formatter = new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });

// "Devamında okuyabilirsiniz" için aynı kategoriden başka bir yazı seç
const siblings = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((p) => p.id !== post.id && p.data.category === post.data.category)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const related = siblings[0];
---
<BaseLayout title={post.data.title} description={post.data.excerpt}>
  <main class="article-shell">

    <div class="article-header">
      <a class="back-link" href="/">← Tüm yazılar</a>
      <div class="article-header__eyebrow">{post.data.category}</div>
      <h1 class="serif">{post.data.title}</h1>
      <div class="article-meta">
        <span>{formatter.format(post.data.date)}</span>
        <span class="dot">·</span>
        <span>{post.data.readingTime}</span>
      </div>
      <svg class="ink-stroke" viewBox="0 0 180 20" aria-hidden="true">
        <path d="M4 14 C 40 4, 80 18, 120 8 S 170 4, 176 10" />
      </svg>
    </div>

    <article class="article-body serif">
      <Content />
    </article>

    <div class="article-footer">
      <div class="tags">
        {post.data.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
      <div class="share">
        <button class="share-btn" id="copyLinkBtn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M10 13a5 5 0 0 0 7.07 0l2.83-2.83a5 5 0 0 0-7.07-7.07l-1.5 1.5" />
            <path d="M14 11a5 5 0 0 0-7.07 0L4.1 13.83a5 5 0 0 0 7.07 7.07l1.5-1.5" />
          </svg>
          <span id="copyLinkLabel">Bağlantıyı kopyala</span>
        </button>
      </div>
    </div>

    {related && (
      <section class="related">
        <h3>Devamında okuyabilirsiniz</h3>
        <a class="post-row" href={`/blog/${related.id}`} style="border-top:1px solid var(--line);">
          <div>
            <div class="post-row__eyebrow">{related.data.category}</div>
            <h2 class="serif">{related.data.title}</h2>
            <p>{related.data.excerpt}</p>
          </div>
          <div class="post-row__meta">
            <span>{formatter.format(related.data.date)}</span>
            <span>{related.data.readingTime}</span>
          </div>
        </a>
      </section>
    )}

  </main>

  <script>
    const copyBtn = document.getElementById('copyLinkBtn');
    const label = document.getElementById('copyLinkLabel');
    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        copyBtn.classList.add('copied');
        if (label) label.textContent = 'Kopyalandı';
        setTimeout(() => {
          copyBtn.classList.remove('copied');
          if (label) label.textContent = 'Bağlantıyı kopyala';
        }, 1800);
      } catch {
        if (label) label.textContent = 'Kopyalanamadı';
      }
    });
  </script>
</BaseLayout>
